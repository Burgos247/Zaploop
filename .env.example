# Supabase — from Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# AES-256-GCM key for NWC URI + Wapupay token encryption.
# Generate with: node scripts/gen-secrets-key.mjs
ZAPLOOP_SECRETS_KEY=

# HMAC-SHA256 key for session cookie signatures.
# Generate with: node scripts/gen-session-key.mjs
ZAPLOOP_SESSION_KEY=
