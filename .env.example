# Zaploop server Nostr keypair.
# Generate with: node scripts/gen-server-keypair.mjs
# The pubkey is browser-side (subscribers NIP-44 encrypt NWC URIs to it).
# The nsec is server-only — the billing worker uses it to decrypt and
# fire pay_invoice on each renewal.
NEXT_PUBLIC_ZAPLOOP_SERVER_PUBKEY=
ZAPLOOP_SERVER_NSEC=

# HMAC-SHA256 key for session cookie signatures.
# Generate with: node scripts/gen-session-key.mjs
ZAPLOOP_SESSION_KEY=

# Bearer secret for POST /api/cron/billing. Generated once; same value
# in Vercel env vars + curl/cron headers.
# Generate with: node scripts/gen-cron-secret.mjs
CRON_SECRET=
